# Dependencies
node_modules
.pnp
.pnp.js

# Build output
dist
dist-ssr
*.local

# TypeScript incremental build caches. Machine- and OS-specific: tsc writes
# canonical (lowercased) paths on case-insensitive filesystems, so a Windows build
# rewrites every entry a macOS/Linux build produced, and vice versa.
*.tsbuildinfo

# Env — never commit real API keys
.env
.env.local
.env.*.local

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test / coverage
coverage

# Playwright
/test-results
/playwright-report
/playwright/.cache

# Azure Functions (api) — deps installed by Oryx; secrets never committed
api/node_modules
api/local.settings.json
bin
obj

# Azure Static Web Apps CLI
.swa
swa-cli-output
