# GolfCourseAPI — LOCAL DEV ONLY
# Sign in / manage your key at https://www.golfcourseapi.com/
# Copy this file to `.env.local` and paste your real key there (never commit it).
#
# When this key is present, the app runs in "direct mode": it calls GolfCourseAPI
# straight from the browser with this key. Convenient for `npm run dev`.
#
# PRODUCTION does NOT use this. The deployed app runs in "proxy mode" and calls
# its own /api endpoints (an Azure Function that holds the key server-side as the
# GOLF_API_KEY app setting). Do NOT set VITE_GOLF_API_KEY in the production build,
# or the key would be inlined into the public bundle. See DEPLOY.md.
VITE_GOLF_API_KEY=your_golfcourseapi_key_here

# Base URL for direct mode (rarely needs changing).
VITE_GOLF_API_BASE_URL=https://api.golfcourseapi.com

# --- Phase 2: optional account sync (Auth0 passwordless) ---
# Sync is OPTIONAL. With these UNSET the app runs exactly like the MVP:
# offline-first, local-only, no login. Set them to enable "Sign in to sync".
# These are PUBLIC values (client id + audience are safe to ship in the bundle;
# there is no client secret in a passwordless SPA flow). See docs/PHASE2-SETUP.md.
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_auth0_spa_client_id
VITE_AUTH0_AUDIENCE=https://api.golftrax.app
